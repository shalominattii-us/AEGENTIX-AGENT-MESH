{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pure ISO Upstream Target",
  "type": "object",
  "required": ["id", "distro", "variant", "release", "architecture", "iso_url", "verification"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"},
    "distro": {"type": "string", "minLength": 1},
    "variant": {"type": "string", "minLength": 1},
    "release": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "enum": ["x86_64", "aarch64", "armv7", "riscv64", "ppc64le", "s390x", "other"]},
    "iso_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "checksum_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "signature_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "signing_key_fingerprint": {"type": "string", "pattern": "^[A-Fa-f0-9 ]{16,80}$"},
    "verification": {
      "type": "object",
      "required": ["required", "mode"],
      "properties": {
        "required": {"const": true},
        "mode": {"type": "string", "enum": ["signed-checksum", "detached-signature", "reproducible-metadata", "manual-review"]}
      },
      "additionalProperties": false
    },
    "expected_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  },
  "additionalProperties": false
}
