{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pure ISO Linux Distro Hygiene Target",
  "type": "object",
  "required": ["id", "name", "architecture", "iso"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "name": {"type": "string", "minLength": 1},
    "architecture": {"type": "array", "items": {"enum": ["x86_64", "aarch64", "riscv64"]}},
    "iso": {"type": "object", "required": ["url", "sha256"], "properties": {"url": {"type": "string", "format": "uri"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}},
    "base_family": {"type": "string"},
    "variant": {"type": "string"},
    "enabled": {"type": "boolean", "default": true}
  },
  "additionalProperties": true
}
